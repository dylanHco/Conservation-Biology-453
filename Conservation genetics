  grepl("^(BN|HM|BS)(-|$)", samples) ~ "Bluffs",
  grepl("^OP(-|$)", samples)         ~ "Out_planted",
  grepl("^PDA(-|$)", samples)        ~ "PHDODA",
  grepl("^PDB(-|$)", samples)        ~ "PHDODB",
  grepl("^(E|D|M|C|B|A)(-|$)", samples) ~ "Main",
  TRUE ~ NA_character_
)

# Check assignments
table(group, useNA = "ifany")

# Assign groups to genind object
