# Lets make a structure plot. Here we are using output from a program called ADMIXTURE that computes 1) the most likely number of clusters and 2) membership of each individual. 
# To run programs like ADMIXTURE you need provide it with a K value. K is the number of clusters you think applies to your samples. Generally, you will never have a single cluster and the very least would be a k=2.
# ADMIXTURE was run in a linux environment using multiple computing nodes to make it run faster than using a single computer. In doing so I tested K=2 to k=10 and with 20 replicates of each.
#From this I determined (based on cross validation scores) that K=3 or K=4 are the most likely number of clusters. Follow the code below to visualize the results. 

library(ggplot2)
library(tidyr)
library(dplyr)
library(tidyverse)
library(patchwork)

admix_data <- read.table("physaria_K4.txt", header=FALSE)
admix_data <- read.table("physaria_K3.txt", header=FALSE)

# Read data
admix_k4 <- read.table("physaria_K4.txt", header = FALSE)
admix_k3 <- read.table("physaria_K3.txt", header = FALSE)

# Assign column names
names(admix_k4) <- c("Sample", paste0("Cluster", 1:4))
names(admix_k3) <- c("Sample", paste0("Cluster", 1:3))

# Convert each dataset to long format
k4_long <- admix_k4 %>%
  pivot_longer(
    cols = starts_with("Cluster"),
    names_to = "Cluster",
    values_to = "Ancestry"
  ) %>%
  mutate(K = "K = 4")

k3_long <- admix_k3 %>%
  pivot_longer(
    cols = starts_with("Cluster"),
    names_to = "Cluster",
    values_to = "Ancestry"
  ) %>%
  mutate(K = "K = 3")

# Combine datasets
admix_long <- bind_rows(k4_long, k3_long)

# Population names
pop_levels <- c("E", "D", "M", "C", "B", "A",
                "BN", "HM", "BS", "OP", "SM", "PDA", "PDB")

admix_long <- admix_long %>%
  mutate(
    Population = sub("-.*", "", Sample),
    Population = factor(Population, levels = pop_levels),
    K = factor(K, levels = c("K = 4", "K = 3"))
  )

# Check that both datasets contain the same samples
stopifnot(setequal(admix_k4$Sample, admix_k3$Sample))

# Determine sample order using K = 4
sample_order <- k4_long %>%
  group_by(Sample) %>%
  summarise(
    MainCluster = Cluster[which.max(Ancestry)],
    MaxAncestry = max(Ancestry),
    .groups = "drop"
  ) %>%
  mutate(Population = factor(sub("-.*", "", Sample),
                             levels = pop_levels)) %>%
  arrange(Population, MainCluster, desc(MaxAncestry)) %>%
  pull(Sample)

# Apply identical sample order to both datasets
admix_long$Sample <- factor(admix_long$Sample, levels = sample_order)

# Population boundaries and label positions
sample_info <- admix_long %>%
  filter(K == "K = 4") %>%
  distinct(Sample, Population) %>%
  arrange(Sample)

pop_info <- sample_info %>%
  group_by(Population) %>%
  summarise(
    start = min(as.numeric(Sample)),
    end = max(as.numeric(Sample)),
    middle = (start + end) / 2,
    .groups = "drop"
  )

# Cluster colors
cluster_colors <- c(
  "Cluster1" = "#E69F00",
  "Cluster2" = "#56B4E9",
  "Cluster3" = "#009E73",
  "Cluster4" = "#CC79A7"
)

# Plot both K values
p <- ggplot(admix_long,
            aes(x = Sample, y = Ancestry, fill = Cluster)) +
  
  geom_col(width = 1) +
  
  # Population separators
  geom_vline(
    data = pop_info[-nrow(pop_info), ],
    aes(xintercept = end + 0.5),
    inherit.aes = FALSE,
    linewidth = 0.7
  ) +
  
  # Population labels only on the bottom panel
  geom_text(
    data = pop_info %>% mutate(K = factor("K = 3",
                                          levels = c("K = 4", "K = 3"))),
    aes(x = middle, y = -0.05, label = Population),
    inherit.aes = FALSE,
    size = 7.5
  ) +
  
  facet_grid(K ~ ., switch = "y") +
  
  scale_fill_manual(values = cluster_colors) +
  
  scale_y_continuous(expand = c(0, 0)) +
  
  scale_x_discrete(expand = c(0, 0)) +
  
  coord_cartesian(ylim = c(-0.08, 1), clip = "off") +
  
  theme_minimal() +
  
  theme(
    legend.position = "none",
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    axis.title = element_blank(),
    panel.grid = element_blank(),
    strip.placement = "outside",
    strip.text.y.left = element_text(size = 12, angle = 0),
    plot.margin = margin(10, 10, 30, 10),
    panel.spacing.y = unit(0.15, "lines")
  )

p

# Save
ggsave("Physaria_K3_K4_ADMIX.pdf",
       plot = p,
       width = 24,
       height = 10)



